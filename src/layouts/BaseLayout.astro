---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import ContactChooser from '../components/ContactChooser.astro';
import { NAP } from '../config';
import type { Lang } from '../config';
import { getSettings } from '../lib/settings';
import { localizedPath } from '../i18n/routes';

interface Props {
  lang: Lang;
  slug: string; // locale-agnostic slug for this page ('' = home)
  title: string;
  description: string;
  ogImage?: string;
}

const { lang, slug, title, description, ogImage = 'assets/img/formosa-booth.jpg' } = Astro.props;
const site = Astro.site!; // from astro.config (final domain 🚩)
const settings = await getSettings();
const announce = settings.announcement ? settings.announcement[lang] : '';

const canonical = new URL(localizedPath(lang, slug), site).href;
const enHref = new URL(localizedPath('en', slug), site).href;
const msHref = new URL(localizedPath('ms', slug), site).href;
const ogImageUrl = new URL(ogImage, site).href;
const htmlLang = lang === 'ms' ? 'ms-MY' : 'en-MY';
const ogLocale = lang === 'ms' ? 'ms_MY' : 'en_MY';
const ogLocaleAlt = lang === 'ms' ? 'en_MY' : 'ms_MY';

// LocalBusiness JSON-LD — real NAP, confirmed by client.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HomeGoodsStore',
  name: NAP.name,
  image: ogImageUrl,
  '@id': site.href,
  url: canonical,
  telephone: '+' + settings.contacts[0].intl,
  contactPoint: settings.contacts.map((c) => ({
    '@type': 'ContactPoint',
    telephone: '+' + c.intl,
    contactType: 'sales',
    areaServed: 'MY',
    availableLanguage: ['ms', 'en'],
  })),
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: NAP.street,
    addressLocality: NAP.locality,
    addressRegion: NAP.region,
    postalCode: NAP.postalCode,
    addressCountry: NAP.country,
  },
  areaServed: ['Kajang', 'Klang Valley', 'Selangor', 'Kuala Lumpur', 'Bangi', 'Semenyih', 'Cheras'],
  geo: { '@type': 'GeoCoordinates', latitude: NAP.geo.lat, longitude: NAP.geo.lng },
  hasMap: NAP.googleMaps,
  openingHours: NAP.openingHours,
  sameAs: [settings.facebook],
  description:
    'Manufacturer and supplier of cabinet door panels, kitchen cabinets (incl. stainless steel), home furniture, fittings, appliances and accessories in Kajang, Selangor.',
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- hreflang -->
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="ms" href={msHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />

    <!-- icons -->
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="apple-touch-icon" href="/favicon.jpg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HOMADE SELANGOR SDN BHD" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#8fb01f" />
    <meta name="robots" content="index, follow" />

    <!-- fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    {announce && (
      <div style="background:#6e8a17;color:#fff;text-align:center;padding:8px 16px;font-size:.9rem;font-weight:500">{announce}</div>
    )}
    <Header lang={lang} slug={slug} />
    <slot />
    <Footer lang={lang} slug={slug} />
    <WhatsAppFloat lang={lang} />
    <ContactChooser lang={lang} />
  </body>
</html>
